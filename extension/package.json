{
  "name": "bookmoor-extension",
  "version": "0.12.0",
  "private": true,
  "description": "Browser extension for bookmoor (Chrome first, Firefox later)",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --no-warnings --test \"e2e/*.test.ts\"",
    "test:e2e:chromium": "node --experimental-strip-types --no-warnings --test e2e/chromium.test.ts",
    "test:e2e:firefox": "node --experimental-strip-types --no-warnings --test e2e/firefox.test.ts",
    "gen:types": "node gen-types.mjs",
    "check:types": "node gen-types.mjs --check",
    "package:firefox": "web-ext build --source-dir dist-firefox --artifacts-dir web-ext-artifacts --overwrite-dest",
    "lint:firefox": "web-ext lint --source-dir dist-firefox",
    "sign:firefox": "web-ext sign --source-dir dist-firefox --artifacts-dir web-ext-artifacts --channel unlisted"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.20.5",
    "@types/selenium-webdriver": "4.35.7",
    "esbuild": "^0.25.0",
    "json-schema-to-typescript": "^15.0.4",
    "playwright-core": "1.63.0",
    "selenium-webdriver": "4.52.0",
    "typescript": "^5.6.0",
    "web-ext": "10.8.0"
  }
}
