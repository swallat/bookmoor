{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Maintenance policy: docs/maintenance.md. Later package rules win over earlier ones.",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    "helpers:pinGitHubActionDigests",
    "customManagers:githubActionsVersions"
  ],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1-5"],
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "platformAutomerge": false,
  "automergeType": "pr",
  "rebaseWhen": "behind-base-branch",
  "semanticCommits": "disabled",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": null,
    "addLabels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-5 * * 1"],
    "automerge": true,
    "minimumReleaseAge": null
  },
  "packageRules": [
    {
      "description": "Merge non-major updates once every check on the PR is green.",
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "Group GitHub Actions updates.",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "groupName": "github actions"
    },
    {
      "description": "Group the Rust crates.",
      "matchManagers": ["cargo"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "rust dependencies"
    },
    {
      "description": "Group the npm dev tools of the extension.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "npm dependencies"
    },
    {
      "description": "0.x versions: a minor step may break the API, treat it like a major.",
      "matchCurrentVersion": "/^(==|~=|>=|\\^|~|v)?0\\./",
      "matchUpdateTypes": ["minor"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Core libraries (auth, crypto, server, schema) and the extension build chain: patches merge, minor updates wait.",
      "matchPackageNames": [
        "argon2",
        "openidconnect",
        "p256",
        "sha2",
        "sha1",
        "hmac",
        "subtle",
        "getrandom",
        "ciborium",
        "axum",
        "tokio",
        "schemars",
        "typescript",
        "esbuild",
        "web-ext"
      ],
      "matchUpdateTypes": ["minor"],
      "groupName": "core libraries",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Language runtimes, toolchains and base images: never merged on their own.",
      "matchDepNames": ["node", "rust", "rustc", "debian"],
      "groupName": null,
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Container images and tool versions: never merged on their own.",
      "matchManagers": ["dockerfile", "docker-compose", "mise"],
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Actions that handle registry credentials: never merged on their own.",
      "matchPackageNames": ["docker/login-action", "docker/build-push-action"],
      "groupName": "release chain actions",
      "automerge": false,
      "addLabels": ["needs-review"]
    },
    {
      "description": "Major updates are only prepared, never merged on their own.",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["needs-review", "major"]
    }
  ]
}
